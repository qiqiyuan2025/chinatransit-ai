---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getTranslations, getLocalePath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/translations';

const locale: Locale = 'fr';
const t = getTranslations(locale);

let posts = await getCollection('blog', (entry) => entry.id.startsWith('fr/'));
if (posts.length === 0) {
  posts = await getCollection('blog', (entry) => entry.id.startsWith('en/'));
}
const sorted = posts.sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---

<Layout title={`Blog — ChinaTransit`} description="Guides et conseils pour visiter la Chine avec le transit sans visa de 240 heures." locale={locale}>
  <section class="max-w-reading mx-auto px-4 py-16">
    <h1 class="font-display text-4xl font-bold text-ink mb-4">Guides & Conseils</h1>
    <p class="text-ink-light mb-12">Tout ce que vous devez savoir pour visiter la Chine en transit sans visa de 240 heures.</p>

    <div class="space-y-10">
      {sorted.map((post) => {
        const slug = post.id.replace(/^(en|fr)\//, '').replace(/\.md$/, '');
        return (
          <article class="border-b border-paper-300 pb-10">
            <a href={`/fr/blog/${slug}`} class="group">
              <h2 class="font-display text-2xl font-semibold text-ink group-hover:text-mineral transition-colors mb-2">
                {post.data.title}
              </h2>
            </a>
            <p class="text-ink-light text-sm mb-3">{post.data.description}</p>
            <time datetime={post.data.publishedAt} class="text-xs text-ink-light">
              {new Date(post.data.publishedAt).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
