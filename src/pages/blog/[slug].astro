---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getTranslations, getLocalePath } from '../../i18n/utils';
import type { Locale } from '../../i18n/translations';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (entry) => entry.id.startsWith('en/'));
  return posts.map((post) => ({
    params: { slug: post.id.replace('en/', '').replace(/\.md$/, '') },
    props: { post },
  }));
}

const locale: Locale = 'en';
const t = getTranslations(locale);
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — ChinaTransit`} description={post.data.description} locale={locale}>
  <article class="max-w-reading mx-auto px-4 py-16">
    <header class="mb-10">
      <a href="/blog" class="text-mineral text-sm hover:underline mb-4 inline-block">&larr; All guides</a>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-ink mb-4">{post.data.title}</h1>
      <div class="flex items-center gap-4 text-sm text-ink-light">
        <time datetime={post.data.publishedAt}>
          {new Date(post.data.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <div class="flex gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="bg-paper-200 px-2 py-0.5 rounded text-xs">{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <div class="prose prose-ink max-w-none
      [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3
      [&_p]:text-ink [&_p]:leading-relaxed [&_p]:mb-4
      [&_a]:text-mineral [&_a]:underline [&_a]:hover:text-mineral-light
      [&_strong]:text-ink [&_strong]:font-semibold
      [&_ul]:my-4 [&_ul]:pl-6 [&_li]:mb-2 [&_li]:text-ink
      [&_ol]:my-4 [&_ol]:pl-6 [&_ol_li]:mb-2
      [&_blockquote]:border-l-4 [&_blockquote]:border-mineral [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-ink-light
      [&_table]:w-full [&_table]:my-6 [&_table]:text-sm
      [&_th]:text-left [&_th]:py-2 [&_th]:px-3 [&_th]:bg-paper-200 [&_th]:font-semibold [&_th]:border [&_th]:border-paper-300
      [&_td]:py-2 [&_td]:px-3 [&_td]:border [&_td]:border-paper-300
      [&_hr]:my-8 [&_hr]:border-paper-300
    ">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-paper-300">
      <div class="bg-paper-100 rounded-lg p-6 border border-paper-300">
        <h3 class="font-display text-xl font-semibold mb-2">Check your eligibility</h3>
        <p class="text-ink-light text-sm mb-4">Find out in 30 seconds if you qualify for China's 240-hour visa-free transit.</p>
        <a href="/check" class="inline-block bg-mineral text-paper-50 px-6 py-2.5 rounded-lg font-semibold text-sm hover:bg-mineral-light transition-colors">
          Check now
        </a>
      </div>
    </footer>
  </article>
</Layout>
